      "passages": [
        {
          "position": 1,
          "kind": "comparison",
          "text": "Poya maginḍsinḍ ‘man’; Ta. magaṉ ‘son’ ‘child’ ‘male person’, Ka. magan ‘son’, Tu. mage ‘id.’, Te. magaḍu ‘male’ ‘husband’"
        },
        {
          "position": 2,
          "kind": "source-analysis",
          "text": "sinḍ = son (q.v.)"
        },
        {
          "position": 3,
          "kind": "literal-gloss",
          "text": "maginḍ sinḍ literally means ‘male person’"
        },
        {
          "position": 4,
          "kind": "comparison",
          "text": "cf. Beng. bæṭā-chēlē."
        },
        {
          "position": 5,
          "kind": "source-analysis",
          "text": "The word is mag, while -nḍ is the 3rd pers. sing. masc. suffix"
        },
        {
          "position": 6,
          "kind": "comparison",
          "text": "cf. Sav. magvānḍu, pl. magvār ‘man’"
        }
