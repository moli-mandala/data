{"key": "lsi9.2:p233:native-line:22", "raw_source_native": "मैं इतना बरस-तैं तेरी टहल करूँ-सूँ अर कदी तेरो कह्यो ना गेर्यो-सै मल तैं कदी मूँ-नैं", "native_word_keys": ["lsi9.2:p233:native-line:22:word:1", "lsi9.2:p233:native-line:22:word:2", "lsi9.2:p233:native-line:22:word:3", "lsi9.2:p233:native-line:22:word:4", "lsi9.2:p233:native-line:22:word:5", "lsi9.2:p233:native-line:22:word:6", "lsi9.2:p233:native-line:22:word:7", "lsi9.2:p233:native-line:22:word:8", "lsi9.2:p233:native-line:22:word:9", "lsi9.2:p233:native-line:22:word:10", "lsi9.2:p233:native-line:22:word:11", "lsi9.2:p233:native-line:22:word:12", "lsi9.2:p233:native-line:22:word:13", "lsi9.2:p233:native-line:22:word:14", "lsi9.2:p233:native-line:22:word:15", "lsi9.2:p233:native-line:22:word:16"], "source_image": "tmp/jambu-next-source/ahirwati-native-specimens-20260927/printed-233-pdf-250-Im250.png", "source_image_sha256": "af068e3077bc88ad93d24b95eb10c22d93e08e2c0488388bde42eb6c68d7098f"}
