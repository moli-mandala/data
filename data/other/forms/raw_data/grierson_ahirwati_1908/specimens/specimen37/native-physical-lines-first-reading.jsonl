{"key": "lsi9.2:p233:native-line:19", "raw_source_native": "मिहिनती-नैं बोल्यो कि, यो के सै। उन कही के तेरो भाई आयो-सै और तेरा बाबा-जी-नैं", "native_word_keys": ["lsi9.2:p233:native-line:19:word:1", "lsi9.2:p233:native-line:19:word:2", "lsi9.2:p233:native-line:19:word:3", "lsi9.2:p233:native-line:19:word:4", "lsi9.2:p233:native-line:19:word:5", "lsi9.2:p233:native-line:19:word:6", "lsi9.2:p233:native-line:19:word:7", "lsi9.2:p233:native-line:19:word:8", "lsi9.2:p233:native-line:19:word:9", "lsi9.2:p233:native-line:19:word:10", "lsi9.2:p233:native-line:19:word:11", "lsi9.2:p233:native-line:19:word:12", "lsi9.2:p233:native-line:19:word:13", "lsi9.2:p233:native-line:19:word:14", "lsi9.2:p233:native-line:19:word:15"], "source_image": "tmp/jambu-next-source/ahirwati-native-specimens-20260927/printed-233-pdf-250-Im250.png", "source_image_sha256": "af068e3077bc88ad93d24b95eb10c22d93e08e2c0488388bde42eb6c68d7098f"}
{"key": "lsi9.2:p233:native-line:20", "raw_source_native": "बड़ी खातर-दारी करी-सै न्यूँ-अक वह-तैं राजी-खुसी आ-मिल्यो। वोह छोह हो-कर भीतर", "native_word_keys": ["lsi9.2:p233:native-line:20:word:1", "lsi9.2:p233:native-line:20:word:2", "lsi9.2:p233:native-line:20:word:3", "lsi9.2:p233:native-line:20:word:4", "lsi9.2:p233:native-line:20:word:5", "lsi9.2:p233:native-line:20:word:6", "lsi9.2:p233:native-line:20:word:7", "lsi9.2:p233:native-line:20:word:8", "lsi9.2:p233:native-line:20:word:9", "lsi9.2:p233:native-line:20:word:10", "lsi9.2:p233:native-line:20:word:11"], "source_image": "tmp/jambu-next-source/ahirwati-native-specimens-20260927/printed-233-pdf-250-Im250.png", "source_image_sha256": "af068e3077bc88ad93d24b95eb10c22d93e08e2c0488388bde42eb6c68d7098f"}
