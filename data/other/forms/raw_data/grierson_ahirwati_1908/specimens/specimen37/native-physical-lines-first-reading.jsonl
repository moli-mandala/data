{"key": "lsi9.2:p233:native-line:17", "raw_source_native": "जन्म लियो-सै। खूयो पायो-सै। जब वो चाव-चोचळ करण लग्यो॥", "native_word_keys": ["lsi9.2:p233:native-line:17:word:1", "lsi9.2:p233:native-line:17:word:2", "lsi9.2:p233:native-line:17:word:3", "lsi9.2:p233:native-line:17:word:4", "lsi9.2:p233:native-line:17:word:5", "lsi9.2:p233:native-line:17:word:6", "lsi9.2:p233:native-line:17:word:7", "lsi9.2:p233:native-line:17:word:8", "lsi9.2:p233:native-line:17:word:9"], "source_image": "tmp/jambu-next-source/ahirwati-native-specimens-20260927/printed-233-pdf-250-Im250.png", "source_image_sha256": "af068e3077bc88ad93d24b95eb10c22d93e08e2c0488388bde42eb6c68d7098f"}
