{"source_unit_key": "grierson1916suketi:prompt:223", "prompt": 223, "printed_page": 767, "pdf_page": 783, "form": "Tērē bābbā-rē gharā kitnī putr hē?", "gloss": "how many sons are there in your father's house?", "review": "visual-second-pass"}
{"source_unit_key": "grierson1916suketi:prompt:224", "prompt": 224, "printed_page": 767, "pdf_page": 783, "form": "Āj maĩ baṛī bāṭ hāḍī", "gloss": "I have walked a long way today", "review": "visual-second-pass"}
{"source_unit_key": "grierson1916suketi:prompt:225", "prompt": 225, "printed_page": 767, "pdf_page": 783, "form": "Mērē chāchē-rā putr mērī bahṇī-kanē byāhī-rā", "gloss": "the son of my uncle is married to his sister", "review": "visual-second-pass"}
{"source_unit_key": "grierson1916suketi:prompt:226", "prompt": 226, "printed_page": 767, "pdf_page": 783, "form": "Us sapēd ghōṛē-rī kāṭhī gharā hī", "gloss": "in the house is the saddle of the white horse", "review": "visual-second-pass"}
{"source_unit_key": "grierson1916suketi:prompt:227", "prompt": 227, "printed_page": 767, "pdf_page": 783, "form": "Us-par jin pāō", "gloss": "put the saddle upon his back", "review": "visual-second-pass"}
{"source_unit_key": "grierson1916suketi:prompt:228", "prompt": 228, "printed_page": 767, "pdf_page": 783, "form": "Maĩ us-rē putrā-jō bahōt kōrṛē mārē", "gloss": "I have beaten his son with many stripes", "review": "visual-second-pass"}
{"source_unit_key": "grierson1916suketi:prompt:229", "prompt": 229, "printed_page": 767, "pdf_page": 783, "form": "Ōh pahāṛā-rī chōṭī-par ḍaṅgar chāryā kardā", "gloss": "he is grazing cattle on the top of the hill", "review": "visual-second-pass"}
{"source_unit_key": "grierson1916suketi:prompt:230", "prompt": 230, "printed_page": 767, "pdf_page": 783, "form": "Ōh ēkī ghōṛē-par us ḍālā-hēṭh baiṭhī-rā", "gloss": "he is sitting on a horse under that tree", "review": "visual-second-pass"}
{"source_unit_key": "grierson1916suketi:prompt:231", "prompt": 231, "printed_page": 767, "pdf_page": 783, "form": "Us-rā bhāī us-rī bhaiṇā-tē lambā hā", "gloss": "his brother is taller than his sister", "review": "visual-second-pass"}
{"source_unit_key": "grierson1916suketi:prompt:232", "prompt": 232, "printed_page": 767, "pdf_page": 783, "form": "Us-rā mul ḍhāī rupai hā", "gloss": "the price of that is two rupees and a half", "review": "visual-second-pass"}
{"source_unit_key": "grierson1916suketi:prompt:233", "prompt": 233, "printed_page": 767, "pdf_page": 783, "form": "Mērā bāpū us chhōṭē gharā rahā̃ hā", "gloss": "my father lives in that small house", "review": "visual-second-pass"}
{"source_unit_key": "grierson1916suketi:prompt:234", "prompt": 234, "printed_page": 767, "pdf_page": 783, "form": "Ēh rupaiyā us-jō dēī-dēō", "gloss": "give this rupee to him", "review": "visual-second-pass"}
{"source_unit_key": "grierson1916suketi:prompt:235", "prompt": 235, "printed_page": 767, "pdf_page": 783, "form": "Ōh rupaiyē us-tē lēī-lēō", "gloss": "take those rupees from him", "review": "visual-second-pass"}
{"source_unit_key": "grierson1916suketi:prompt:236", "prompt": 236, "printed_page": 767, "pdf_page": 783, "form": "Us-jō ain mārō atē rassī-kanē bāuhī-dēō", "gloss": "beat him well and bind him with ropes", "review": "visual-second-pass"}
{"source_unit_key": "grierson1916suketi:prompt:237", "prompt": 237, "printed_page": 767, "pdf_page": 783, "form": "Us khūē-tē pāṇī kāḍhō", "gloss": "draw water from the well", "review": "visual-second-pass"}
{"source_unit_key": "grierson1916suketi:prompt:238", "prompt": 238, "printed_page": 767, "pdf_page": 783, "form": "Mērē āgē āgē chalō", "gloss": "walk before me", "review": "visual-second-pass"}
{"source_unit_key": "grierson1916suketi:prompt:239", "prompt": 239, "printed_page": 767, "pdf_page": 783, "form": "Tussē-rē pīchhē kĕs-rā muṇḍū āyā kardā?", "gloss": "whose boy comes behind you?", "review": "visual-second-pass"}
{"source_unit_key": "grierson1916suketi:prompt:240", "prompt": 240, "printed_page": 767, "pdf_page": 783, "form": "Ēh tussē kĕs-tē khāṇḍyā?", "gloss": "from whom did you buy that?", "review": "visual-second-pass"}
{"source_unit_key": "grierson1916suketi:prompt:241", "prompt": 241, "printed_page": 767, "pdf_page": 783, "form": "Us gāō̃-rē ēkī haṭwāṇī-tē", "gloss": "from a shopkeeper of the village", "review": "visual-second-pass"}
