{"source_unit_key": "nair2013kakkala:p30:imperative-singular-markers", "printed_page": 30, "source_claim": "Kakkala singular imperative can lack a suffix or take -u; Malayalam –ū serves both numbers. Zero is described, not printed as a glyph.", "note": "", "physical_witnesses": [{"physical_key": "nair2013kakkala:p30:imperative-singular-markers:w1", "witness": {"form": "-u", "gloss": "", "language_label": "Kakkala", "role": "target", "source_analysis": "imperative singular suffix", "note": "", "witness_key": "nair2013kakkala:p30:imperative-singular-markers:w1"}, "disposition": "emitted", "entry_keys": ["nair2013kakkala:p30:imperative-singular-markers:w1"], "hold_reason": ""}, {"physical_key": "nair2013kakkala:p30:imperative-singular-markers:w2", "witness": {"form": "–ū", "gloss": "", "language_label": "Malayalam", "role": "comparison", "source_analysis": "imperative singular and plural marker", "note": "", "witness_key": "nair2013kakkala:p30:imperative-singular-markers:w2"}, "disposition": "emitted", "entry_keys": ["nair2013kakkala:p30:imperative-singular-markers:w2"], "hold_reason": ""}], "entry_keys": ["nair2013kakkala:p30:imperative-singular-markers:w1", "nair2013kakkala:p30:imperative-singular-markers:w2"], "accepted_for_source_stage": true, "acceptance_evidence": {"report": "independent-review/root-original-review-final-20260927462.json", "sha256": "258456ee6098257c3ae44bce86f09e99c6015989d6c1c015d2f656d7c3abdb8d", "scope": "complete chapter source-stage rows; no full compiled/browser gate"}}
{"source_unit_key": "nair2013kakkala:p30:imperative-singular-examples", "printed_page": 30, "source_claim": "", "note": "", "physical_witnesses": [{"physical_key": "nair2013kakkala:p30:imperative-singular-examples:w1", "witness": {"form": "ari", "gloss": "you (Sg) cut", "language_label": "Kakkala", "role": "target", "source_analysis": "imperative singular", "note": "", "witness_key": "nair2013kakkala:p30:imperative-singular-examples:w1"}, "disposition": "emitted", "entry_keys": ["nair2013kakkala:p30:imperative-singular-examples:w1"], "hold_reason": ""}, {"physical_key": "nair2013kakkala:p30:imperative-singular-examples:w2", "witness": {"form": "ara", "gloss": "you (Sg.) grind", "language_label": "Kakkala", "role": "target", "source_analysis": "imperative singular", "note": "", "witness_key": "nair2013kakkala:p30:imperative-singular-examples:w2"}, "disposition": "emitted", "entry_keys": ["nair2013kakkala:p30:imperative-singular-examples:w2"], "hold_reason": ""}, {"physical_key": "nair2013kakkala:p30:imperative-singular-examples:w3", "witness": {"form": "kalamb -u", "gloss": "you(sg.) see", "language_label": "Kakkala", "role": "target", "source_analysis": "imperative singular", "note": "", "witness_key": "nair2013kakkala:p30:imperative-singular-examples:w3"}, "disposition": "emitted", "entry_keys": ["nair2013kakkala:p30:imperative-singular-examples:w3"], "hold_reason": ""}, {"physical_key": "nair2013kakkala:p30:imperative-singular-examples:w4", "witness": {"form": "kattir -u", "gloss": "you (Sg.) burn", "language_label": "Kakkala", "role": "target", "source_analysis": "imperative singular", "note": "", "witness_key": "nair2013kakkala:p30:imperative-singular-examples:w4"}, "disposition": "emitted", "entry_keys": ["nair2013kakkala:p30:imperative-singular-examples:w4"], "hold_reason": ""}], "entry_keys": ["nair2013kakkala:p30:imperative-singular-examples:w1", "nair2013kakkala:p30:imperative-singular-examples:w2", "nair2013kakkala:p30:imperative-singular-examples:w3", "na