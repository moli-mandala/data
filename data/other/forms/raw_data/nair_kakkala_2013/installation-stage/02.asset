{"source_unit_key": "nair2013kakkala:p29:purposive-marker", "printed_page": 29, "source_claim": "Purposive marker is attena (cf. Ma. aan). No printed leading dash.", "note": "", "physical_witnesses": [{"physical_key": "nair2013kakkala:p29:purposive-marker:w1", "witness": {"form": "attena", "gloss": "", "language_label": "Kakkala", "role": "target", "source_analysis": "purposive marker", "note": "", "witness_key": "nair2013kakkala:p29:purposive-marker:w1"}, "disposition": "emitted", "entry_keys": ["nair2013kakkala:p29:purposive-marker:w1"], "hold_reason": ""}, {"physical_key": "nair2013kakkala:p29:purposive-marker:w2", "witness": {"form": "aan", "gloss": "", "language_label": "Malayalam", "role": "comparison", "source_analysis": "purposive marker", "note": "", "witness_key": "nair2013kakkala:p29:purposive-marker:w2"}, "disposition": "emitted", "entry_keys": ["nair2013kakkala:p29:purposive-marker:w2"], "hold_reason": ""}], "entry_keys": ["nair2013kakkala:p29:purposive-marker:w1", "nair2013kakkala:p29:purposive-marker:w2"], "accepted_for_source_stage": true, "acceptance_evidence": {"report": "independent-review/root-original-review-final-20260927462.json", "sha256": "258456ee6098257c3ae44bce86f09e99c6015989d6c1c015d2f656d7c3abdb8d", "scope": "complete chapter source-stage rows; no full compiled/browser gate"}}
