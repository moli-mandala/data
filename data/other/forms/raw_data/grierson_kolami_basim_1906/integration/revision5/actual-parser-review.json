    },
    {
      "entry_key": "grierson1906kolamibasim:p564:specimen75-line:1:word:4:expression",
      "Original": "Amnuṅg iddar bālākōl āṇḍēr.",
      "display": "amnuŋg iddar bālākōl āṇḍēr",
      "terminal_punctuation_only_before_approved_profile": true
    },
    {
      "entry_key": "grierson1906kolamibasim:p564:specimen75-line:2:word:8:expression",
      "Original": "Mārī amd avaruṅg dhan pāyāknā siten.",
      "display": "mārī amd avaruŋg dhan pāyāknā siten",
      "terminal_punctuation_only_before_approved_profile": true
    },
    {
      "entry_key": "grierson1906kolamibasim:p564:specimen75-line:3:word:4:expression",
      "Original": "Mārī kōnnūṅg divasānī tsinnām bālā attānā ghumkāknā laya dhāv seden.",
      "display": "mārī kōnnūŋg divasānī tsinnām bālā attānā ghumkāknā laya dhāv seden",
      "terminal_punctuation_only_before_approved_profile": true
    },
    {
      "entry_key": "grierson1906kolamibasim:p564:specimen75-line:4:word:6:expression",
      "Original": "Attīn amd mājiltālā tān jiṅgī uḍāpten.",
      "display": "attīn amd mājiltālā tān jiŋgī uḍāpten",
      "terminal_punctuation_only_before_approved_profile": true
    },
    {
      "entry_key": "grierson1906kolamibasim:p564:specimen75-line:5:word:3:expression",
      "Original": "Mārī amd attānā kharchipten, add muluk mahāg paṭṭīn.",
      "display": "mārī amd attānā kharchipten, add muluk mahāg paṭṭīn",
      "terminal_punctuation_only_before_approved_profile": true
    },
    {
      "entry_key": "grierson1906kolamibasim:p564:specimen75-line:6:word:2:expression",
      "Original": "Ad-muḷ amnuṅg aḍchan paṭṭīn.",
      "display": "ad-muḷ amnuŋg aḍchan paṭṭīn",
      "terminal_punctuation_only_before_approved_profile": true
    },
    {
      "entry_key": "grierson1906kolamibasim:p564:specimen75-line:6:word:6:expression",
      "Original": "Addī vakhōt amd ad muluk ōkōn māsan-āttin setnā tākten.",
      "display": "addī vakhōt amd ad muluk ōkōn māsan-āttin setnā tākten",
      "terminal_punctuation_only_before_approved_profile": true
    },
    {
      "entry_key": "grierson1906kolamibasim:p564:specimen75-line:7:word:6:expression",
      "Original": "Amd amnuṅg turel kāyeṅg tānet vegāḍuṅg pānākten.",
      "display": "amd amnuŋg turel kāyeŋg tānet vegāḍuŋg pānākten",
      "terminal_punctuation_only_before_approved_profile": true
    },
    {
      "entry_key": "grierson1906kolamibasim:p564:specimen75-line:8:word:5:expression",
      "Original": "Addī vakhōt turel sōse tinhā ādnāḍ amd pōṭā niḍinā anāṅg amnun vāṭīltīn.",
      "display": "addī vakhōt turel sōse tinhā ādnāḍ amd pōṭā niḍinā anāŋg amnun vāṭīltīn",
      "terminal_punctuation_only_before_approved_profile": true
    },
    {
      "entry_key": "grierson1906kolamibasim:p564:specimen75-line:9:word:8:expression",
      "Original": "Amnuṅg yēnā siyeten.",
      "display": "amnuŋg yēnā siyeten",
      "terminal_punctuation_only_before_approved_profile": true
    },
    {
      "entry_key": "grierson1906kolamibasim:p564:specimen75-line:14:word:3:expression",
      "Original": "Mārī amd sūltnā tān bānāṅg sedden.",
      "display": "mārī amd sūltnā tān bānāŋg sedden",
      "terminal_punctuation_only_before_approved_profile": true
    },
    {
      "entry_key": "grierson1906kolamibasim:p564:specimen75-line:14:word:9:expression",
      "Original": "Mārī amd dhāv aṇḍān ittet amnet tāk ōltnā, lōbha vāttīn, amd tūltnā amne mākkun ārāgā-paṭṭīn amnet mukā samnet.",
      "display": "mārī amd dhāv aṇḍān ittet amnet tāk ōltnā, lōbha vāttīn, amd tūltnā amne mākkun ārāgā-paṭṭīn amnet mukā samnet",
      "terminal_punctuation_only_before_approved_profile": true
    },
    {
      "entry_key": "grierson1906kolamibasim:p565:specimen75-line:4:word:6:expression",
      "Original": "Mārī amd anand kākeṅg utten.",
      "display": "mārī amd anand kākeŋg utten",
      "terminal_punctuation_only_before_approved_profile": true
    },
    {
      "entry_key": "grierson1906kolamibasim:p565:specimen75-line:6:word:1:expression",
      "Original": "Id vakhōt amnet vaḍlāk bālā vegāṭ āṇḍen.",
      "display": "id vakhōt amnet vaḍlāk bālā vegāṭ āṇḍen",
      "terminal_punctuation_only_before_approved_profile": true
    },
    {
      "entry_key": "grierson1906kolamibasim:p565:specimen75-line:6:word:8:expression",
      "Original": "Mārī amd vātnā ellā-merāt vātten.",
      "display": "mārī amd vātnā ellā-merāt vātten",
      "terminal_punctuation_only_before_approved_profile": true
    },
    {
      "entry_key": "grierson1906kolamibasim:p565:specimen75-line:7:word:3:expression",
      "Original": "Amd mōrapākād endākād vintēr.",
      "display": "amd mōrapākād endākād vintēr",
      "terminal_punctuation_only_before_approved_profile": true
    },
    {
      "entry_key": "grierson1906kolamibasim:p565:specimen75-line:10:word:5:expression",
      "Original": "Mārī amd kātiṅg vātnā ōpāl seren.",
      "display": "mārī amd kātiŋg vātnā ōpāl seren",
      "terminal_punctuation_only_before_approved_profile": true
